        {"id": "A-08-01-04", "t": "二部图", "ty": "概念", "d": "节点分为两个集合，边只存在于不同集合之间。", "k": ["典型：用户-物品、作者-论文", "可用于推荐/匹配", "常转化为单部图分析"], "f": "", "pre": ["A-08-01-03"], "rel": ["A-08-01-05"], "p": "p.244", "m": "M9 / graph §2", "c": "核心"},
        {"id": "A-08-01-05", "t": "最短路径、直径与平均路径", "ty": "概念", "d": "最短路径是两节点间边数/权重最小的路径；直径是所有节点对最短路径的最大值；平均路径是均值。", "k": ["BFS 求无权最短跳数", "Dijkstra 求加权最短路径", "直径衡量图的宽度", "平均路径衡量小世界特性"], "f": "", "pre": ["A-08-01-03"], "rel": ["A-08-02-13"], "p": "p.244", "m": "M9 / graph §3.1", "c": "核心"},
        {"id": "A-08-01-06", "t": "环与特殊路径", "ty": "概念", "d": "环是起点终点相同的路径；自回避路径不重复节点；欧拉路径经过每条边一次；汉密尔顿路径经过每个节点一次。", "k": ["环检测用于依赖/欺诈环", "自回避路径用于路径枚举", "欧拉/汉密尔顿是图论经典问题", "工程中更常用环/连通分量"], "f": "", "pre": ["A-08-01-05"], "rel": ["A-08-02-18"], "p": "p.244-246", "m": "M9 / graph §2", "c": "背景"},
        {"id": "A-08-01-07", "t": "聚集系数", "ty": "概念", "d": "聚集系数衡量节点邻居之间相互连接的程度。", "k": ["局部聚集系数 = 实际边数/可能边数", "衡量社区紧密程度", "可用于异常/团伙检测"], "f": "C_i = 2e_i / (k_i(k_i−1))", "pre": ["A-08-01-02"], "rel": ["A-08-02-22"], "p": "p.245-246", "m": "M9 / graph §2", "c": "核心"},
        {"id": "A-08-01-08", "t": "六度理论", "ty": "概念", "d": "社交网络中任意两人最多通过六跳建立关联，体现小世界特性。", "k": ["短路径普遍存在", "互联网时代跳数更少", "用于社交/传播分析"], "f": "", "pre": ["A-08-01-05"], "rel": ["A-08-01-09"], "p": "p.246", "m": "M9 / graph §2", "c": "背景"},
        {"id": "A-08-01-09", "t": "弱联系", "ty": "概念", "d": "强关系连接的小群体之间，弱关系常承担信息桥接作用。", "k": ["信息常通过弱关系传播", "弱关系连接不同社群", "对推荐/传播有启发"], "f": "", "pre": ["A-08-01-08"], "rel": ["A-08-02-17"], "p": "p.246", "m": "M9 / graph §2", "c": "背景"},
        {"id": "A-08-01-10", "t": "无尺度网络与幂律", "ty": "概念", "d": "少数枢纽节点拥有大量连接，度分布服从幂律；可由优先连接（BA 模型）生成。", "k": ["优先连接：新节点倾向连高度节点", "度分布长尾", "Web/合作网络/演员网络常见"], "f": "P(k) ~ k^(−γ)", "pre": ["A-08-01-02"], "rel": ["A-08-01-11"], "p": "p.246-248", "m": "M9 / graph §2", "c": "核心"},
        {"id": "A-08-01-11", "t": "随机网络模型", "ty": "概念", "d": "Erdos-Renyi 模型以概率 p 连边，度分布近似二项/泊松；用于随机基线对照。", "k": ["给定 n、p 随机连边", "度分布有峰值", "与无尺度网络形成对比"], "f": "P(k)=C(n−1,k)p^k(1−p)^(n−1−k)", "pre": ["A-08-01-10"], "rel": ["A-08-02-12"], "p": "p.248-250", "m": "M9 / graph §2", "c": "核心"}
      ]
