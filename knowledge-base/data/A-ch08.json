    {
      "sec": "8.2",
      "title": "基础图算法",
      "points": [
        {"id": "A-08-02-12", "t": "图算法三类", "ty": "原则", "d": "传统图算法分路径/搜索、中心度分析、社区发现三类。", "k": ["路径/搜索：最短路、生成树", "中心度：影响力/瓶颈", "社区发现：聚类/团伙", "按问题选算法"], "f": "", "pre": ["A-08-01-11"], "rel": ["A-08-02-13"], "p": "p.250-251", "m": "M9 / graph §3", "c": "核心"},
        {"id": "A-08-02-13", "t": "Dijkstra 最短路径", "ty": "算法", "d": "Dijkstra 用贪心策略求单源最短加权路径，适合非负权重图。", "k": ["逐步扩展最近节点", "d[i] 维护当前最短距离", "非负权重；负权需 Bellman-Ford"], "f": "d[v] = min(d[v], d[u]+w(u,v))", "pre": ["A-08-01-05"], "rel": ["A-08-02-14"], "p": "p.252", "m": "M9 / graph §3.1", "c": "核心"},
        {"id": "A-08-02-14", "t": "最小生成树与 Kruskal", "ty": "算法", "d": "最小生成树是连通所有节点且总权重最小的树；Kruskal 按边权从小到大加入且不成环。", "k": ["连通图才有生成树", "Kruskal：排序边 + 并查集", "应用：通信/管道/道路规划"], "f": "", "pre": ["A-08-01-05"], "rel": ["A-08-02-15"], "p": "p.252-253", "m": "M9 / graph §3.1", "c": "核心"},
        {"id": "A-08-02-15", "t": "中心度算法", "ty": "方法", "d": "中心度衡量节点重要性，包括度中心度、中介中心度、接近中心度、PageRank 等。", "k": ["度中心度：连接数", "中介中心度：最短路径桥梁", "接近中心度：到其他节点平均距离", "PageRank：邻居重要性递归"], "f": "", "pre": ["A-08-02-12"], "rel": ["A-08-02-16"], "p": "p.254", "m": "M9 / graph §3.2", "c": "核心"},
        {"id": "A-08-02-16", "t": "PageRank", "ty": "算法", "d": "PageRank 用链接数量与来源重要性递归估计节点重要性。", "k": ["重要页面更可能被重要页面链接", "迭代：节点值=入链贡献之和", "需处理悬挂节点/阻尼系数"], "f": "PR(u) = (1−d) + d Σ PR(v)/L(v)", "pre": ["A-08-02-15"], "rel": ["A-08-02-17"], "p": "p.254-255", "m": "M9 / graph §3.2", "c": "核心"},
        {"id": "A-08-02-17", "t": "中介中心度", "ty": "算法", "d": "中介中心度统计经过节点的最短路径比例，衡量其作为桥梁/瓶颈的程度。", "k": ["经过该节点的最短路数/总最短路数", "高分节点是跨群桥梁", "可用于通信/运输瓶颈分析"], "f": "", "pre": ["A-08-02-15"], "rel": ["A-08-02-19"], "p": "p.255", "m": "M9 / graph §3.2", "c": "核心"},
        {"id": "A-08-02-18", "t": "社区发现", "ty": "方法", "d": "社区发现把图划分为内部连接紧密、外部连接稀疏的节点组。", "k": ["社区内交互多于社区外", "用于社群/团伙/领域划分", "结果需业务解释与稳定性评估"], "f": "", "pre": ["A-08-02-12"], "rel": ["A-08-02-19"], "p": "p.256", "m": "M9 / graph §3.3", "c": "核心"},
        {"id": "A-08-02-19", "t": "强/弱连通分量", "ty": "算法", "d": "强连通分量是有向图内互相可达的极大节点组；弱连通分量忽略方向后的连通组。", "k": ["强连通：Kosaraju/Tarjan", "弱连通：并查集", "用于依赖/引用环与碎片化分析"], "f": "", "pre": ["A-08-02-18"], "rel": ["A-08-02-20"], "p": "p.256-257", "m": "M9 / graph §3.3", "c": "核心"},
        {"id": "A-08-02-20", "t": "标签传播 LPA", "ty": "算法", "d": "标签传播让节点采用邻居多数标签，快速形成社区。", "k": ["密集区域标签快速占主导", "结果可能不稳定", "多次运行/固定随机种子"], "f": "", "pre": ["A-08-02-19"], "rel": ["A-08-02-21"], "p": "p.257", "m": "M9 / graph §3.3", "c": "核心"},
        {"id": "A-08-02-21", "t": "Louvain 与模块度", "ty": "算法", "d": "Louvain 通过最大化模块度做社区发现：节点移动 + 社区折叠两阶段。", "k": ["模块度衡量社区紧密程度", "阶段1：节点加入邻居社区", "阶段2：社区折叠成超节点", "分辨率限制需注意"], "f": "Q = (1/2m) Σ [A_ij − k_i k_j/2m] δ(c_i,c_j)", "pre": ["A-08-02-20"], "rel": ["A-08-02-22"], "p": "p.257-258", "m": "M9 / graph §3.3", "c": "核心"},
        {"id": "A-08-02-22", "t": "三角计数与平均聚集系数", "ty": "方法", "d": "统计三角形数量与平均聚集系数，衡量局部聚集程度。", "k": ["三角计数用于紧密群/欺诈环", "平均聚集系数衡量整体聚集", "可与社区发现互补"], "f": "", "pre": ["A-08-01-07"], "rel": ["A-08-02-21"], "p": "p.257", "m": "M9 / graph §3.3", "c": "专项"}
      ]
