      "points": [
        {"id": "A-08-03-23", "t": "图表示学习", "ty": "概念", "d": "把图中节点映射为低维向量，使结构与语义相似性可计算。", "k": ["保留结构/语义特性", "用于节点分类/链接预测/聚类", "分随机游走与 GNN 两类"], "f": "", "pre": ["A-08-01-03"], "rel": ["A-08-03-24"], "p": "p.259-260", "m": "M9 / graph §4", "c": "核心"},
        {"id": "A-08-03-24", "t": "DeepWalk", "ty": "模型", "d": "DeepWalk 用随机游走生成节点序列，再用 Skip-gram 学习节点向量。", "k": ["随机游走定义结构上下文", "Skip-gram 最大化共现", "无监督、可扩展", "只捕获邻近性"], "f": "", "pre": ["A-08-03-23"], "rel": ["A-08-03-25"], "p": "p.261", "m": "M9 / graph §4", "c": "核心"},
        {"id": "A-08-03-25", "t": "Node2Vec", "ty": "模型", "d": "Node2Vec 用有偏随机游走（p/q 参数）兼顾内容相似与结构相似。", "k": ["p：返回参数", "q>1 偏 BFS（同质）", "q<1 偏 DFS（结构）", "需调参"], "f": "", "pre": ["A-08-03-24"], "rel": ["A-08-03-26"], "p": "p.261-263", "m": "M9 / graph §4", "c": "核心"},
        {"id": "A-08-03-26", "t": "LINE", "ty": "模型", "d": "LINE 用一阶/二阶相似度学习节点表示，支持有向/加权图。", "k": ["一阶：直接边权重", "二阶：共享邻居", "弥补一阶稀疏", "适合大图"], "f": "", "pre": ["A-08-03-25"], "rel": ["A-08-03-27"], "p": "p.263", "m": "M9 / graph §4", "c": "核心"},
        {"id": "A-08-03-27", "t": "NetMF", "ty": "模型", "d": "NetMF 把 DeepWalk/LINE/Node2Vec 统一为矩阵分解框架，并给出显式矩阵分解算法。", "k": ["Skip-gram 隐式矩阵分解", "DeepWalk ≈ 拉普拉斯低秩变换", "LINE ≈ 窗口为1的特例", "显式分解可优于原算法"], "f": "", "pre": ["A-08-03-26"], "rel": ["A-08-03-28"], "p": "p.263-264", "m": "M9 / graph §4", "c": "专项"},
        {"id": "A-08-03-28", "t": "Metapath2Vec", "ty": "模型", "d": "Metapath2Vec 用元路径指导异构图的随机游走，保留类型语义。", "k": ["元路径定义节点类型序列", "如 APA 表示共同作者", "避免高频类型主导", "需设计元路径"], "f": "", "pre": ["A-08-03-25"], "rel": ["A-08-03-29"], "p": "p.264-265", "m": "M9 / graph §4", "c": "核心"},
        {"id": "A-08-03-29", "t": "图神经网络概述", "ty": "概念", "d": "GNN 通过聚合邻居信息更新节点表示，多层堆叠扩大感受野。", "k": ["消息传递/邻居聚合", "节点表示由邻居共同决定", "可半监督/自监督训练"], "f": "", "pre": ["A-08-03-23"], "rel": ["A-08-03-30"], "p": "p.265-266", "m": "M9 / graph §5", "c": "核心"},
        {"id": "A-08-03-30", "t": "直推学习与归纳学习", "ty": "对比", "d": "直推在训练时见过测试节点；归纳需泛化到新节点/子图。", "k": ["直推：效果通常更好、不能泛化新节点", "归纳：泛化更好、工程更常用", "GCN 偏直推；GraphSAGE/GAT 可归纳"], "f": "", "pre": ["A-08-03-29"], "rel": ["A-08-03-31"], "p": "p.266", "m": "M9 / graph §5.1", "c": "核心"},
        {"id": "A-08-03-31", "t": "GCN", "ty": "模型", "d": "GCN 对邻居特征做归一化聚合，再与自身特征融合，通过多层传播学习节点表示。", "k": ["邻居均值 + 自连接", "参数共享", "适合半监督节点分类", "需固定邻接"], "f": "h_v^(k)=σ(Σ_{j∈N(v)∪{v}} (1/√(d_v d_j)) W_k h_j^(k−1))", "pre": ["A-08-03-29"], "rel": ["A-08-03-32"], "p": "p.266-267", "m": "M9 / graph §5.2", "c": "核心"},
        {"id": "A-08-03-32", "t": "VGAE", "ty": "模型", "d": "VGAE 用编码器-解码器学习节点潜在分布，并通过重建邻接矩阵做无监督表示学习。", "k": ["输入：特征矩阵 + 邻接矩阵", "编码器输出均值/方差", "解码器重建边", "编码器可复用为表示工具"], "f": "", "pre": ["A-08-03-31"], "rel": ["A-08-03-33"], "p": "p.267-268", "m": "M9 / graph §5.2", "c": "核心"},
        {"id": "A-08-03-33", "t": "GAT", "ty": "模型", "d": "GAT 用注意力机制为不同邻居分配不同权重，再聚合邻居特征。", "k": ["邻居重要性不同", "注意力并行计算", "可泛化到新图", "多头注意力增强"], "f": "α_ij = softmax_j(LeakyReLU(aᵀ[Wh_i‖Wh_j]))", "pre": ["A-08-03-31"], "rel": ["A-08-03-34"], "p": "p.268", "m": "M9 / graph §5.2", "c": "核心"},
        {"id": "A-08-03-34", "t": "GraphSAGE", "ty": "模型", "d": "GraphSAGE 对邻居随机采样后用聚合函数生成节点表示，支持大规模与归纳学习。", "k": ["邻居采样控制计算量", "聚合器：Mean/Pool/LSTM", "聚合后与自身特征拼接", "可泛化到新节点"], "f": "", "pre": ["A-08-03-33"], "rel": ["A-08-03-35"], "p": "p.268-269", "m": "M9 / graph §5.2", "c": "核心"},
        {"id": "A-08-03-35", "t": "DiffPool 层次池化", "ty": "模型", "d": "DiffPool 通过可微聚类把细粒度节点聚成超节点，处理图级/多粒度任务。", "k": ["节点聚类为超节点", "超节点表示由簇内节点聚合", "邻接由分配矩阵生成", "池化矩阵成本高"], "f": "", "pre": ["A-08-03-34"], "rel": ["A-08-03-36"], "p": "p.269-270", "m": "M9 / graph §5.2", "c": "专项"},
        {"id": "A-08-03-36", "t": "GPT-GNN 生成式预训练", "ty": "模型", "d": "GPT-GNN 用自回归生成图结构与节点属性作为自监督任务，预训练图神经网络。", "k": ["随机排序节点", "掩码边/属性", "属性生成 + 结构生成", "下游微调标签效率高"], "f": "", "pre": ["A-08-03-29"], "rel": ["A-08-03-37"], "p": "p.270-272", "m": "M9 / graph §5.3", "c": "专项"},
        {"id": "A-08-03-37", "t": "GCC 对比学习预训练", "ty": "模型", "d": "GCC 用同一中心节点的子图作为正样本、不同节点子图作为负样本，做图对比学习。", "k": ["随机游走生成子图", "子图结构相似性", "InfoNCE 损失", "跨图预训练"], "f": "", "pre": ["A-08-03-36"], "rel": ["A-08-04-38"], "p": "p.272-273", "m": "M9 / graph §5.3", "c": "专项"}
      ]
