        {"id": "B-03-06-16", "t": "对抗训练", "ty": "方法", "d": "用对抗训练学习语言不变特征，使模型难以区分语言来源，从而提取跨语言共性。", "k": ["判别器区分语言", "编码器学习不变特征", "对抗平衡获得共性", "需防止负迁移"], "f": "", "pre": ["B-03-06-15"], "rel": ["B-03-07-17"], "p": "p.113-120", "m": "M3 / distilled §5.3", "c": "核心"}
      ]
