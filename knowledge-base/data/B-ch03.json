    {
      "sec": "3.1",
      "title": "章节引言",
      "points": [
        {"id": "B-03-01-01", "t": "远程监督的两大问题", "ty": "原则", "d": "远程监督自动标注会带来数据噪声与长尾问题，限制关系抽取性能。", "k": ["噪声：强假设导致错误标注", "长尾：关系/实体分布呈幂律", "两者都影响训练与覆盖"], "f": "", "pre": ["B-02-09-41"], "rel": ["B-03-01-02"], "p": "p.83-84", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-01-02", "t": "两个研究方向", "ty": "原则", "d": "一是利用大规模远程监督数据同时降噪；二是引入多源/多语言信息缓解长尾。", "k": ["降噪：注意力/对抗/互注意力", "扩源：多语言/图谱-文本联合", "目标是更鲁棒、更全覆盖"], "f": "", "pre": ["B-03-01-01"], "rel": ["B-03-02-03"], "p": "p.84", "m": "M3 / distilled §5.3", "c": "核心"}
      ]
    },
    {
      "sec": "3.2",
      "title": "相关工作",
      "points": [
        {"id": "B-03-02-03", "t": "有监督关系抽取", "ty": "方法", "d": "把关系抽取建模为分类任务，需要人工标注句子；效果好但标注成本高、领域迁移难。", "k": ["输入：含实体对的句子", "输出：关系类别", "依赖大规模标注", "跨领域泛化差"], "f": "", "pre": ["B-03-01-02"], "rel": ["B-03-02-04"], "p": "p.84-85", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-02-04", "t": "远程监督关系抽取", "ty": "方法", "d": "用知识库三元组对齐文本自动标注训练数据，假设包含同一实体对的句子都表达该关系。", "k": ["知识库 → 文本对齐", "自动生成大规模训练集", "假设过强、噪声大", "是关系抽取的重要范式"], "f": "（比尔·盖茨，创始人，微软）→ 含两实体的句子标为“创始人”", "pre": ["B-03-02-03"], "rel": ["B-03-02-05"], "p": "p.85", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-02-05", "t": "多实例学习与 bag", "ty": "方法", "d": "把包含同一实体对的句子组成 bag，在 bag 级别做关系预测，降低单句噪声影响。", "k": ["bag = 同一实体对的句子集合", "bag 级标签来自知识库", "可学习句子权重", "bag 级评估更贴近真实使用"], "f": "", "pre": ["B-03-02-04"], "rel": ["B-03-03-06"], "p": "p.85-90", "m": "M3 / distilled §5.3", "c": "核心"}
      ]
    },
    {
      "sec": "3.3",
      "title": "基于选择性注意力机制的关系抽取",
      "points": [
        {"id": "B-03-03-06", "t": "句级选择性注意力", "ty": "模型", "d": "对同一实体对的多个句子学习注意力权重，加权聚合为 bag 表示，降低噪声句影响。", "k": ["句子编码器（CNN/RNN）", "注意力打分", "加权求和", "端到端训练"], "f": "s_bag = Σ α_i s_i", "pre": ["B-03-02-05"], "rel": ["B-03-03-07"], "p": "p.90-92", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-03-07", "t": "bag 表示与关系分类", "ty": "方法", "d": "bag 表示输入分类器预测关系；注意力权重可指示哪些句子更可信。", "k": ["bag 表示 → 关系分类", "注意力权重可解释", "同一实体对多关系需多标签"], "f": "", "pre": ["B-03-03-06"], "rel": ["B-03-03-08"], "p": "p.92-93", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-03-08", "t": "选择性注意力的可解释性", "ty": "方法", "d": "高注意力句子通常确实表达目标关系，低注意力句子常是噪声或无关语义。", "k": ["高权重句子可作为证据", "低权重句子可过滤", "便于人工审核"], "f": "", "pre": ["B-03-03-07"], "rel": ["B-03-04-09"], "p": "p.93-96", "m": "M3 / distilled §5.3", "c": "核心"}
      ]
    },
