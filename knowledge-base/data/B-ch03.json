        {"id": "B-03-04-10", "t": "HATT 两层注意力", "ty": "模型", "d": "HATT 在句子层与关系层分别做注意力：底层选实例，顶层共享关系间信息。", "k": ["底层：细粒度实例选择", "顶层：粗粒度关系关联", "长尾关系利用父关系数据", "比单层注意力更稳"], "f": "", "pre": ["B-03-04-09"], "rel": ["B-03-04-11"], "p": "p.96-98", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-04-11", "t": "HATT 的长尾效果", "ty": "方法", "d": "关系层次注意力在长尾关系上表现更好，因为顶层可借用高频关系的训练信号。", "k": ["长尾关系样本少", "父关系/相关关系提供正则", "实验显示一致提升"], "f": "", "pre": ["B-03-04-10"], "rel": ["B-03-05-12"], "p": "p.99-103", "m": "M3 / distilled §5.3", "c": "核心"}
      ]
