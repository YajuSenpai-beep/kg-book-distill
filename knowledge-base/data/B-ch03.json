      "points": [
        {"id": "B-03-05-12", "t": "多语言关系抽取", "ty": "概念", "d": "同一关系在不同语言中有相似模式，可利用多语言数据的一致性与互补性提升抽取。", "k": ["不同语言共享关系语义", "单语数据可能覆盖不足", "多语言可扩大训练信号"], "f": "", "pre": ["B-03-04-11"], "rel": ["B-03-05-13"], "p": "p.103", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-05-13", "t": "MNRE 单语与跨语言注意力", "ty": "模型", "d": "MNRE 在每种语言内做选择性注意力，再用跨语言注意力融合多语言实例。", "k": ["单语注意力筛选实例", "跨语言注意力融合", "利用语言一致/互补", "需多语言对齐"], "f": "", "pre": ["B-03-05-12"], "rel": ["B-03-05-14"], "p": "p.103-105", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-05-14", "t": "多语言一致性与互补性", "ty": "原则", "d": "不同语言对同一关系有共同模式（一致性），也能提供单语缺失的视角（互补性）。", "k": ["一致性：关系模式跨语言相似", "互补性：不同语言覆盖不同表达", "融合可提升召回与鲁棒"], "f": "", "pre": ["B-03-05-13"], "rel": ["B-03-06-15"], "p": "p.105-112", "m": "M3 / distilled §5.3", "c": "核心"}
      ]
