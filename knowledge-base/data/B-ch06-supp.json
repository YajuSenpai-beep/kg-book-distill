    {
      "sec": "6.3",
      "title": "基于协同过滤和矩阵分解的义原预测",
      "points": [
        {
          "id": "B-06-03-41",
          "t": "SPWE 评分与置信因子",
          "ty": "方法",
          "d": "SPWE 用相似词义原标注加权打分，并用相似度排名的指数衰减抑制远邻噪声。",
          "k": [
            "余弦相似度",
            "义原标注矩阵 M",
            "c^{r_i} 置信因子",
            "top-k 推荐"
          ],
          "f": "P(s_j,w)=Σ cos(w,w_i)M_ij c^{r_i}",
          "pre": [
            "B-06-03-05"
          ],
          "rel": [
            "B-06-03-42"
          ],
          "p": "p.181-182",
          "m": "M10 / language §4.2",
          "c": "核心"
        },
        {
          "id": "B-06-03-42",
          "t": "SPWE 的适用与局限",
          "ty": "原则",
          "d": "SPWE 对高频词有效；低频词词向量不可靠时效果下降，需要字信息/跨语言补充。",
          "k": [
            "高频词好",
            "低频词差",
            "依赖词向量",
            "可与矩阵分解互补"
          ],
          "f": "",
          "pre": [
            "B-06-03-41"
          ],
          "rel": [
            "B-06-04-47"
          ],
          "p": "p.182",
          "m": "M10 / language §4.2",
          "c": "核心"
        },
        {
          "id": "B-06-03-43",
          "t": "SPSE 的目标函数",
          "ty": "方法",
          "d": "同时分解词-义原矩阵与义原-义原 PMI 矩阵，学习词与义原的统一嵌入。",
          "k": [
            "词-义原矩阵 M",
            "义原-义原 PMI 矩阵 C",
            "固定词嵌入",
            "L2 损失 + λ 平衡"
          ],
          "f": "L=Σ(w_i·(s_j+s̄_j)+b_i+b_j−M_ij)²+λΣ(s_j·s̄_k−C_jk)²",
          "pre": [
            "B-06-03-06"
          ],
          "rel": [
            "B-06-03-44"
          ],
          "p": "p.182-183",
          "m": "M10 / language §4.3",
          "c": "核心"
        },
        {
          "id": "B-06-03-44",
          "t": "义原-义原 PMI 矩阵",
          "ty": "概念",
          "d": "用点互信息衡量义原共现关系，把义原间语义相关性注入嵌入。",
          "k": [
            "PMI(s_j,s_k)",
            "共现统计",
            "义原关系",
            "辅助稀疏预测"
          ],
          "f": "PMI(x,y)=log(P(x,y)/(P(x)P(y)))",
          "pre": [
            "B-06-03-43"
          ],
          "rel": [
            "B-06-03-45"
          ],
          "p": "p.182",
          "m": "M10 / language §4.3",
          "c": "核心"
        },
        {
          "id": "B-06-03-45",
          "t": "SPASE 的加性假设",
          "ty": "模型",
          "d": "SPASE 假设词向量是义原嵌入的加权和，通过分解词嵌入矩阵学义原嵌入。",
          "k": [
            "w_i=Σ M_ij s_j",
            "词嵌入固定",
            "参数少",
            "复杂组合表达受限"
          ],
          "f": "w_i=Σ_{s_j∈S_wi} M_ij s_j",
          "pre": [
            "B-06-03-07"
          ],
          "rel": [
            "B-06-03-46"
          ],
          "p": "p.183-184",
          "m": "M10 / language §4.3",
          "c": "核心"
        },
        {
          "id": "B-06-03-46",
          "t": "稀疏矩阵采样",
          "ty": "方法",
          "d": "词-义原矩阵极稀疏；对 0 元素低概率采样、非 0 元素全采样，避免 0 主导。",
          "k": [
            "0 元素 0.5% 采样",
            "非 0 全采样",
            "聚焦有效标注",
            "提升分解效果"
          ],
          "f": "",
          "pre": [
            "B-06-03-43"
          ],
          "rel": [
            "B-06-03-47"
          ],
          "p": "p.183",
          "m": "M10 / language §4.3",
          "c": "核心"
        },
        {
          "id": "B-06-03-47",
          "t": "集成学习（加权融合）",
          "ty": "方法",
          "d": "SPWE 与 SPSE/SPASE 互补，可用加权评分融合提升预测。",
          "k": [
            "协同过滤 + 矩阵分解",
            "不同偏差",
            "加权融合",
            "通常优于单模型"
          ],
          "f": "",
          "pre": [
            "B-06-03-42"
          ],
