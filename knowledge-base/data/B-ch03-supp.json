      "sec": "3.2",
      "title": "相关工作",
      "points": [
        {"id": "B-03-02-41", "t": "远程监督的强假设", "ty": "原则", "d": "远程监督假设：若知识库中存在实体对的关系，则包含该实体对的句子都表达该关系。", "k": ["假设是启发式、非必然", "一个实体对可能有多关系", "一个句子可能不表达该关系", "噪声由此产生"], "f": "", "pre": ["B-03-02-04"], "rel": ["B-03-02-42"], "p": "p.85", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-02-42", "t": "远程监督噪声类型", "ty": "概念", "d": "噪声主要来自错误标注、实体对多关系、句子语义偏离、实体链接错误。", "k": ["错误标注：句子不表达该关系", "多关系：同一实体对多关系", "语义偏离：提及但非断言", "链接错误：实体识别/链接错误"], "f": "", "pre": ["B-03-02-41"], "rel": ["B-03-03-46"], "p": "p.85-86", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-02-43", "t": "句级与 bag 级评估", "ty": "方法", "d": "句级评估看单句预测，bag 级评估聚合同一实体对的句子；远程监督更应报告 bag 级。", "k": ["句级：每句一个标签", "bag 级：实体对级别", "bag 级更贴近知识库补全", "两者都需报告"], "f": "", "pre": ["B-03-02-05"], "rel": ["B-03-03-06"], "p": "p.86-90", "m": "M3 / quality-rubric §3.3", "c": "核心"},
        {"id": "B-03-02-44", "t": "NYT 远程监督数据集", "ty": "系统", "d": "NYT 语料用 Stanford NER 标注实体并链接到 Freebase，是远程监督关系抽取的常用基准。", "k": ["New York Times 文本", "实体链接到 Freebase", "自动生成 bag 级标签", "含噪声与长尾"], "f": "", "pre": ["B-03-02-43"], "rel": ["B-03-03-06"], "p": "p.86-90", "m": "M3 / distilled §5.3", "c": "背景"},
        {"id": "B-03-02-45", "t": "关系抽取的 P-R 评估", "ty": "方法", "d": "用 precision-recall 曲线/PR-AUC 评估关系抽取，尤其适合类别不平衡与长尾。", "k": ["P-R 曲线展示阈值权衡", "PR-AUC 汇总", "长尾关系单独报告", "不能只看准确率"], "f": "", "pre": ["B-03-02-43"], "rel": ["B-03-08-64"], "p": "p.86-90", "m": "M3 / quality-rubric §3.3", "c": "核心"}
      ]
    },
    {
