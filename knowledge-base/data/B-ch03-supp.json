      "points": [
        {"id": "B-03-03-46", "t": "句子编码器", "ty": "方法", "d": "对每个句子用 CNN/RNN 编码为向量，并拼接实体位置/类型等特征。", "k": ["词向量输入", "位置特征", "CNN/RNN 编码", "句子向量"], "f": "", "pre": ["B-03-03-06"], "rel": ["B-03-03-47"], "p": "p.90-91", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-03-47", "t": "句级注意力计算", "ty": "方法", "d": "用关系向量与句子表示计算注意力分数，softmax 归一化后加权求和成 bag 表示。", "k": ["e_i = s_iᵀ A r", "α_i = softmax(e_i)", "bag = Σ α_i s_i", "关系向量参与打分"], "f": "α_i=exp(s_iᵀAr)/Σ_j exp(s_jᵀAr)", "pre": ["B-03-03-46"], "rel": ["B-03-03-48"], "p": "p.91-92", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-03-48", "t": "bag 分类器", "ty": "方法", "d": "bag 表示经全连接/softmax 预测关系，训练用交叉熵。", "k": ["bag 向量 → 关系分布", "交叉熵损失", "可多标签扩展", "端到端训练"], "f": "", "pre": ["B-03-03-47"], "rel": ["B-03-03-49"], "p": "p.92", "m": "M3 / distilled §5.3", "c": "核心"},
        {"id": "B-03-03-49", "t": "注意力正则与训练技巧", "ty": "方法", "d": "可用注意力熵正则、dropout、实体位置屏蔽等稳定训练，避免注意力塌缩。", "k": ["熵正则鼓励分散", "dropout 防过拟合", "位置特征很重要", "早停/学习率调度"], "f": "", "pre": ["B-03-03-48"], "rel": ["B-03-03-50"], "p": "p.92-93", "m": "M3 / distilled §5.3", "c": "专项"},
        {"id": "B-03-03-50", "t": "注意力可视化", "ty": "方法", "d": "把注意力权重映射回句子，可检查高权重句是否真的表达目标关系。", "k": ["高权重句作为证据", "低权重句可过滤", "人工审核/错误分析", "可解释性卖点"], "f": "", "pre": ["B-03-03-47"], "rel": ["B-03-03-08"], "p": "p.93-96", "m": "M3 / distilled §5.3", "c": "核心"}
