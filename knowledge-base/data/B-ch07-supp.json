      "points": [
        {"id": "B-07-03-49", "t": "SDLM 的动机", "ty": "原则", "d": "传统语言模型以词为基本单位，忽略词义可分解为义原；显式建模义原有望提升效果与可解释性。", "k": ["词不是最小语义单位", "义原组合", "可解释", "未登录词"], "f": "", "pre": ["B-07-03-07"], "rel": ["B-07-03-50"], "p": "p.223", "m": "M10 / language §5.2", "c": "核心"},
        {"id": "B-07-03-50", "t": "义原预测器（Sigmoid 门控）", "ty": "方法", "d": "上下文向量经 Sigmoid 线性层预测每个义原的权重，作为“专家”门控。", "k": ["q_k=σ(gᵀv_k+b_k)", "上下文 g", "义原权重", "门控专家"], "f": "q_k=σ(gᵀv_k+b_k)", "pre": ["B-07-03-08"], "rel": ["B-07-03-51"], "p": "p.224", "m": "M10 / language §5.2", "c": "核心"},
        {"id": "B-07-03-51", "t": "义项预测器（专家积）", "ty": "方法", "d": "每个义原作为专家对相关义项打分，专家概率相乘并归一化。", "k": ["双线性 φ(k)=gᵀU_k w_s", "专家积", "义原-义项连接", "稀疏归一化"], "f": "P(s|g)∝Π_{e_k∈E(s)}P^(k)(s|g)", "pre": ["B-07-03-50"], "rel": ["B-07-03-52"], "p": "p.224-226", "m": "M10 / language §5.2", "c": "核心"},
        {"id": "B-07-03-52", "t": "词预测器（义项求和）", "ty": "方法", "d": "词的概率等于其义项概率之和，实现义原/义项到词的生成。", "k": ["P(w|g)=Σ_{s∈S(w)}P(s|g)", "多义项相加", "输出可解释", "支持未登录词"], "f": "P(w|g)=Σ_{s∈S(w)}P(s|g)", "pre": ["B-07-03-51"], "rel": ["B-07-03-53"], "p": "p.226", "m": "M10 / language §5.2", "c": "核心"},
        {"id": "B-07-03-53", "t": "基底矩阵参数共享", "ty": "方法", "d": "用 R 个基底矩阵的加权和估计每个义原的变换矩阵，降低参数量。", "k": ["U_k=Σ α_{k,r}Q_r", "α 可训练", "减少参数", "防过拟合"], "f": "U_k=Σ_{r=1}^R α_{k,r}Q_r", "pre": ["B-07-03-51"], "rel": ["B-07-03-54"], "p": "p.226", "m": "M10 / language §5.2", "c": "专项"},
        {"id": "B-07-03-54", "t": "权重绑定", "ty": "方法", "d": "对一个词的多个义项使用相同词嵌入，输入/输出嵌入可共享。", "k": ["义项共享词向量", "输入输出绑定", "减少参数", "稳定训练"], "f": "", "pre": ["B-07-03-52"], "rel": ["B-07-03-55"], "p": "p.226", "m": "M10 / language §5.2", "c": "专项"},
        {"id": "B-07-03-55", "t": "困惑度与标题生成评估", "ty": "方法", "d": "在人民日报语料上用困惑度评估语言模型，在 LCSTS 上评估标题生成。", "k": ["Perplexity", "LCSTS", "生成质量", "与 LSTM/AWD-LSTM 比"], "f": "", "pre": ["B-07-03-49"], "rel": ["B-07-03-56"], "p": "p.227-232", "m": "M10 / quality-rubric §7", "c": "核心"},
