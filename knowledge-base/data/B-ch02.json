  "chapter_title": "世界知识的表示学习",
  "sections": [
    {
      "sec": "2.1",
      "title": "章节引言",
      "points": [
        {"id": "B-02-01-01", "t": "世界知识图谱的三个特性", "ty": "原则", "d": "世界 KG 具有实体/关系类型多样、信息载体多模态、高噪声低完整度三个特性。", "k": ["类型多样、规模庞大", "文本/图像/声音等多源信息", "难兼顾质量与覆盖率"], "f": "", "pre": ["B-01-03-12"], "rel": ["B-02-01-02"], "p": "p.32-33", "m": "M5 / distilled §6", "c": "核心"},
        {"id": "B-02-01-02", "t": "世界知识表示学习的两个问题", "ty": "原则", "d": "一是如何建模图谱结构（复杂关系、稀疏、噪声）；二是如何融入图谱外的多源信息。", "k": ["结构建模：复杂关系/路径/属性", "外部信息：描述/类型/图像", "目标是更鲁棒的知识表示"], "f": "", "pre": ["B-02-01-01"], "rel": ["B-02-01-03"], "p": "p.33", "m": "M5 / distilled §6", "c": "核心"},
        {"id": "B-02-01-03", "t": "知识表示学习的目标", "ty": "概念", "d": "把实体与关系表示为低维连续空间向量，使三元组语义可用向量运算刻画。", "k": ["实体/关系 → 向量", "保留结构与语义", "支持链接预测/分类/下游任务"], "f": "h, r, t ∈ R^d", "pre": ["B-02-01-02"], "rel": ["B-02-02-04"], "p": "p.33", "m": "M5 / distilled §6", "c": "核心"}
      ]
    },
    {
      "sec": "2.2",
      "title": "相关工作",
      "points": [
        {"id": "B-02-02-04", "t": "结构向量模型 SE", "ty": "模型", "d": "SE 为每个关系的头/尾实体分别设计投影矩阵，使投影后头尾向量接近。", "k": ["关系特化矩阵 M_r1/M_r2", "评分：投影后距离", "早期尝试，表达力有限"], "f": "E(h,r,t)=‖M_r1 h − M_r2 t‖", "pre": ["B-02-01-03"], "rel": ["B-02-02-05"], "p": "p.33-34", "m": "M5 / distilled §6.1", "c": "背景"},
        {"id": "B-02-02-05", "t": "语义匹配能量模型 SME", "ty": "模型", "d": "SME 用矩阵映射与点乘评估实体/关系联系，分线性与双线性两种评分。", "k": ["实体/关系用低维向量", "线性/双线性评分", "比 SE 更灵活"], "f": "E=(M1h+M2r+b1)(M3t+M4r+b2)", "pre": ["B-02-02-04"], "rel": ["B-02-02-06"], "p": "p.34", "m": "M5 / distilled §6.1", "c": "背景"},
        {"id": "B-02-02-06", "t": "隐变量模型 LFM", "ty": "模型", "d": "LFM 用双线性变换矩阵表示关系，实体为低维向量，计算复杂度较低。", "k": ["关系 = 双线性矩阵", "评分 h M_r t", "对角化可降参"], "f": "E(h,r,t)=h M_r t", "pre": ["B-02-02-05"], "rel": ["B-02-02-07"], "p": "p.34", "m": "M5 / distilled §6.1", "c": "背景"},
        {"id": "B-02-02-07", "t": "矩阵分解模型 RESCAL/HolE", "ty": "模型", "d": "RESCAL 用三阶张量分解表示三元组；HolE 用循环相关改进效率与效果。", "k": ["RESCAL：X ≈ A R Aᵀ", "HolE：循环相关", "表达力强但计算复杂"], "f": "X_i ≈ A R_i Aᵀ", "pre": ["B-02-02-06"], "rel": ["B-02-02-08"], "p": "p.34-35", "m": "M5 / distilled §6.1", "c": "背景"},
        {"id": "B-02-02-08", "t": "神经张量网络 NTN", "ty": "模型", "d": "NTN 用双线性张量 + 单层神经网络刻画实体与关系联系。", "k": ["三阶张量 M_r", "tanh + 投影矩阵", "表达力强、计算复杂", "需要较稠密图谱"], "f": "E=u_rᵀ tanh(hᵀM_r t + M_r1h + M_r2t + b_r)", "pre": ["B-02-02-07"], "rel": ["B-02-02-09"], "p": "p.35", "m": "M5 / distilled §6.1", "c": "背景"},
        {"id": "B-02-02-09", "t": "平移模型 TransE", "ty": "模型", "d": "TransE 把关系视为头到尾的平移向量，要求 h+r≈t；简单高效、可扩展。", "k": ["h+r≈t", "L1/L2 距离评分", "负采样 + 最大间隔", "大规模图谱效果好"], "f": "E(h,r,t)=‖h+r−t‖", "pre": ["B-02-02-08"], "rel": ["B-02-02-10"], "p": "p.35-36", "m": "M5 / distilled §6.1", "c": "核心"},
        {"id": "B-02-02-10", "t": "TransE 的训练目标", "ty": "方法", "d": "用最大间隔损失拉大正负三元组得分差，负样本通过随机替换头/尾实体生成。", "k": ["正例：图谱三元组", "负例：替换头/尾", "margin γ", "SGD 优化"], "f": "L=Σ max(γ+E(h,r,t)−E(h′,r,t′),0)", "pre": ["B-02-02-09"], "rel": ["B-02-02-11"], "p": "p.36", "m": "M5 / distilled §6.4", "c": "核心"},
        {"id": "B-02-02-11", "t": "TransE 的局限", "ty": "原则", "d": "TransE 难处理一对多/多对多、对称/逆/组合关系，且只用局部三元组、忽略路径与外部信息。", "k": ["复杂关系建模差", "忽略全局结构与路径", "忽略文本/类型/图像", "稀疏实体效果差"], "f": "", "pre": ["B-02-02-10"], "rel": ["B-02-02-12"], "p": "p.36-37", "m": "M5 / distilled §6.1", "c": "核心"},
        {"id": "B-02-02-12", "t": "三类改进方向", "ty": "原则", "d": "针对 TransE 的局限，可从复杂关系、关系路径、多源外部信息三个方向改进。", "k": ["复杂关系：TransH/R/D、CTransR", "路径：PTransE", "外部信息：DKRL/TKRL/IKRL", "规则：KALE/IterE"], "f": "", "pre": ["B-02-02-11"], "rel": ["B-02-03-13"], "p": "p.37", "m": "M5 / distilled §6", "c": "核心"}
      ]
    },
    {
      "sec": "2.3",
      "title": "基于复杂关系建模的知识表示学习",
      "points": [
        {"id": "B-02-03-13", "t": "TransR 关系特定空间", "ty": "模型", "d": "TransR 为每个关系定义独立语义空间，用映射矩阵把实体投影到关系空间再做平移。", "k": ["实体空间 → 关系空间", "h_r=M_r h, t_r=M_r t", "评分 ‖h_r+r−t_r‖", "解决实体在不同关系下语义不同"], "f": "h_r=M_r h, t_r=M_r t, f_r=‖h_r+r−t_r‖", "pre": ["B-02-02-12"], "rel": ["B-02-03-14"], "p": "p.38-39", "m": "M5 / distilled §6.2", "c": "核心"},
        {"id": "B-02-03-14", "t": "CTransR 关系内聚类", "ty": "模型", "d": "CTransR 对同一关系的实体对按 h−t 聚类，为每簇学习单独关系向量，并约束其接近全局关系。", "k": ["关系内部语义多样", "按 h−t 聚类", "每簇 r_c", "正则项 α‖r_c−r‖"], "f": "f_r=‖h_{r,c}+r_c−t_{r,c}‖+α‖r_c−r‖", "pre": ["B-02-03-13"], "rel": ["B-02-03-15"], "p": "p.39", "m": "M5 / distilled §6.2", "c": "核心"},
        {"id": "B-02-03-15", "t": "链接预测评测", "ty": "方法", "d": "用知识图谱中其他实体替换 h/t，按得分排序，报告平均排名与 Hit@10；需区分原始/过滤。", "k": ["Mean Rank：越低越好", "Hit@10：前10命中率", "过滤掉其他真实三元组", "按关系基数切片"], "f": "", "pre": ["B-02-03-13"], "rel": ["A-02-04-24"], "p": "p.39-41", "m": "M5 / quality-rubric §3.1", "c": "核心"},
        {"id": "B-02-03-16", "t": "三元组分类", "ty": "方法", "d": "判断给定三元组真假，是二分类任务；按关系设阈值，报告准确率。", "k": ["需要负例三元组", "关系特定阈值 δ_r", "验证集选阈值"], "f": "score < δ_r ⇒ 正确", "pre": ["B-02-03-15"], "rel": ["B-02-03-17"], "p": "p.42-43", "m": "M5 / quality-rubric §3.2", "c": "核心"},
        {"id": "B-02-03-17", "t": "文本关系抽取与 KG 表示结合", "ty": "方法", "d": "把文本关系抽取得分与 KG 表示得分相加排序，可结合文本证据与图谱结构。", "k": ["文本模型 + KG 模型", "得分融合/重排序", "提升关系事实发现"], "f": "", "pre": ["B-02-03-16"], "rel": ["B-03-01-01"], "p": "p.43-44", "m": "M3 / distilled §5.3", "c": "专项"}
      ]
    },
    {
      "sec": "2.4",
      "title": "基于关系路径建模的知识表示学习",
      "points": [
        {"id": "B-02-04-18", "t": "PTransE 路径增强", "ty": "模型", "d": "PTransE 在直接关系之外加入多步关系路径，用路径证据增强知识表示与推理。", "k": ["评分 = 直接关系项 + 路径项", "路径可提供多跳证据", "需评估路径可靠性"], "f": "G(h,r,t)=E(h,r,t)+E(h,P,t)", "pre": ["B-02-03-17"], "rel": ["B-02-04-19"], "p": "p.45-46", "m": "M5 / distilled §6.2", "c": "核心"},
        {"id": "B-02-04-19", "t": "PCRA 路径可靠性", "ty": "算法", "d": "PCRA 用资源分配算法衡量路径可靠性：资源从头实体沿路径流向尾实体，流量越大越可靠。", "k": ["资源从 h 出发", "沿路径分配", "到达 t 的资源量作为可靠性", "限制路径长度/阈值"], "f": "R_p(m)=Σ R_p(n)/|S_i(n,·)|", "pre": ["B-02-04-18"], "rel": ["B-02-04-20"], "p": "p.46", "m": "M5 / distilled §6.2", "c": "核心"},
        {"id": "B-02-04-20", "t": "路径表示方法", "ty": "对比", "d": "路径可表示为关系向量的加法、乘法或 RNN 末状态；加法通常最稳定。", "k": ["加法：p=r1+r2+…", "乘法：p=r1·r2·…", "RNN：末状态", "加法与 TransE 假设一致"], "f": "p=r1+r2+…+r_l", "pre": ["B-02-04-19"], "rel": ["B-02-04-21"], "p": "p.46", "m": "M5 / distilled §6.2", "c": "核心"},
        {"id": "B-02-04-21", "t": "路径增强的实体预测", "ty": "方法", "d": "先用 TransE 排序，再对前 N 候选用 PTransE 重排序，兼顾效率与路径证据。", "k": ["TransE 粗排", "PTransE 细排", "路径搜索成本高", "2–3 步路径通常足够"], "f": "", "pre": ["B-02-04-20"], "rel": ["B-02-04-22"], "p": "p.47-48", "m": "M5 / distilled §6.2", "c": "核心"},
        {"id": "B-02-04-22", "t": "路径增强的关系预测", "ty": "方法", "d": "关系预测给定头尾实体预测关系；PTransE 结合直接关系与路径信息提升命中率。", "k": ["关系数量远少于实体", "Hit@1 更有区分度", "路径可解释"], "f": "", "pre": ["B-02-04-21"], "rel": ["B-02-05-23"], "p": "p.48-49", "m": "M5 / distilled §6.2", "c": "专项"}
      ]
