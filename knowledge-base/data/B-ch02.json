        {"id": "B-02-06-28", "t": "DKRL 双表示联合能量", "ty": "模型", "d": "DKRL 为每个实体学结构表示与描述表示，在统一平移框架下用四项能量联合训练。", "k": ["结构表示 h_s/t_s", "描述表示 h_D/t_D", "四项组合 + 权重 α", "文本/知识空间对齐"], "f": "E=α1‖h_s+r−t_s‖+α2‖h_s+r−t_D‖+α3‖h_D+r−t_s‖+α4‖h_D+r−t_D‖", "pre": ["B-02-06-27"], "rel": ["B-02-06-29"], "p": "p.58-59", "m": "M5 / distilled §6.3", "c": "核心"},
        {"id": "B-02-06-29", "t": "描述编码器 CBOW/CNN", "ty": "方法", "d": "DKRL 用 CBOW（关键词词向量平均）或 CNN（卷积/池化）把实体描述编码为向量。", "k": ["CBOW：TF-IDF 选关键词", "CNN：两层卷积 + 最大/平均池化", "CNN 捕获局部与全局特征"], "f": "", "pre": ["B-02-06-28"], "rel": ["B-02-06-30"], "p": "p.59-60", "m": "M5 / distilled §6.3", "c": "核心"},
        {"id": "B-02-06-30", "t": "DKRL 的零样本能力", "ty": "方法", "d": "DKRL 可由实体描述为新实体构建表示，在训练集未出现的实体上仍有预测能力。", "k": ["FB20K 模拟零样本", "e-e/d-e/e-d/d-d 分组", "描述编码器泛化到新实体"], "f": "", "pre": ["B-02-06-29"], "rel": ["B-02-06-31"], "p": "p.60-61", "m": "M5 / distilled §6.3", "c": "核心"},
        {"id": "B-02-06-31", "t": "DKRL 的效果与局限", "ty": "原则", "d": "DKRL 在链接预测/实体分类上优于基线，零样本有效；但依赖描述质量与覆盖率。", "k": ["描述丰富时增益明显", "描述缺失/噪声大时效果下降", "编码器选择影响结果"], "f": "", "pre": ["B-02-06-30"], "rel": ["B-02-07-32"], "p": "p.61-68", "m": "M5 / distilled §6.3", "c": "核心"}
      ]
