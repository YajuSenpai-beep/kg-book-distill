    {
      "sec": "6.3",
      "title": "基于协同过滤和矩阵分解的义原预测",
      "points": [
        {
          "id": "B-06-03-05",
          "t": "SPWE 词嵌入协同过滤",
          "ty": "模型",
          "d": "用相似词的义原标注为词推荐义原，权重为词向量相似度与置信因子。",
          "k": [
            "相似词共享义原",
            "余弦相似度加权",
            "排名置信因子 c^r",
            "只让最相似词强影响"
          ],
          "f": "P(s_j,w)=Σ cos(w,w_i)·M_ij·c^{r_i}",
          "pre": [
            "B-06-02-04"
          ],
          "rel": [
            "B-06-03-06"
          ],
          "p": "p.181-182",
          "m": "M10 / language §4.2",
          "c": "核心"
        },
        {
          "id": "B-06-03-06",
          "t": "SPSE 义原嵌入矩阵分解",
          "ty": "模型",
          "d": "同时分解词-义原矩阵与义原-义原 PMI 矩阵，把词与义原映射到同一空间。",
          "k": [
            "词-义原矩阵 M",
            "义原-义原矩阵 C=PMI",
            "固定词嵌入学义原嵌入",
            "余弦相似度预测"
          ],
          "f": "L=Σ(w_i·(s_j+ s̄_j)+b_i+b_j−M_ij)²+λΣ(s_j·s̄_k−C_jk)²",
          "pre": [
            "B-06-03-05"
          ],
          "rel": [
            "B-06-03-07"
          ],
          "p": "p.182-183",
          "m": "M10 / language §4.3",
          "c": "核心"
        },
        {
          "id": "B-06-03-07",
          "t": "SPASE 聚合义原嵌入",
          "ty": "模型",
          "d": "假设词向量是义原嵌入的加权和，通过分解词嵌入矩阵学习义原嵌入。",
          "k": [
            "w_i=Σ M_ij s_j",
            "词嵌入固定",
            "参数少、易欠拟合",
            "适合义原组合简单场景"
          ],
          "f": "w_i=Σ_{s_j∈S_wi} M_ij s_j",
          "pre": [
            "B-06-03-06"
          ],
          "rel": [
            "B-06-03-08"
          ],
          "p": "p.183-184",
          "m": "M10 / language §4.3",
          "c": "核心"
        },
        {
