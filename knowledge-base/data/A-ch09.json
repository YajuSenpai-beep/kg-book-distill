        {"id": "A-09-05-25", "t": "PKGM 静态预训练", "ty": "模型", "d": "PKGM 预训练知识图谱模型，为下游提供实体/关系的嵌入向量服务，而不暴露原始三元组。", "k": ["实体/关系嵌入表", "按 ID 查询", "避免重复训练", "支持隐私隔离"], "f": "", "pre": ["A-09-05-24"], "rel": ["A-09-05-26"], "p": "p.334-335", "m": "M11 / frontier §2.3", "c": "核心"},
