      "points": [
        {"id": "A-09-03-14", "t": "事理知识图谱的定义", "ty": "概念", "d": "事理图谱以事件为节点、事件间逻辑关系为边，描述事件演化规律与模式。", "k": ["节点：事件（谓词性短语）", "边：顺承/因果/条件/反转/上下位等", "有向有环图", "边可带概率/置信度"], "f": "", "pre": ["A-09-02-13"], "rel": ["A-09-03-15"], "p": "p.308-310", "m": "M11 / frontier §3", "c": "核心"},
        {"id": "A-09-03-15", "t": "事理图谱与实体图谱的区别", "ty": "对比", "d": "实体图谱描述名词性实体及属性/关系；事理图谱描述谓词性事件及演化逻辑。", "k": ["实体：Who/What/Where/When", "事理：Why/How/下一步", "事件无具体时间地点，强调泛化", "边带概率而非确定事实"], "f": "", "pre": ["A-09-03-14"], "rel": ["A-09-03-16"], "p": "p.310-311", "m": "M11 / frontier §3", "c": "核心"},
        {"id": "A-09-03-16", "t": "事理逻辑关系类型", "ty": "概念", "d": "常见事理关系包括顺承、因果、条件、反转、上下位、组成、并发。", "k": ["顺承：时间先后，带转移概率", "因果：前因后果，带因果强度", "条件：前提与结论（理由≠原因）", "上下位：事件分类", "组成/并发"], "f": "", "pre": ["A-09-03-15"], "rel": ["A-09-03-17"], "p": "p.311-314", "m": "M11 / frontier §3", "c": "核心"},
