    {
      "sec": "9.1",
      "title": "多模态知识图谱",
      "points": [
        {"id": "A-09-01-01", "t": "多模态知识图谱的定义", "ty": "概念", "d": "多模态 KG 融合语言、视觉、听觉等不同模态的数据与知识，形成可关联的多模态知识库。", "k": ["模态 = 信息类型/表示形式", "图像/视频/文本/音频都可承载知识", "目标是模态间互补与关联"], "f": "", "pre": ["A-08-05-01"], "rel": ["A-09-01-02"], "p": "p.285-286", "m": "M11 / frontier §1", "c": "核心"},
        {"id": "A-09-01-02", "t": "System 1 与 System 2", "ty": "概念", "d": "认知系统分快速直觉的 System 1 与有意识推理的 System 2；KG 更接近后者，多模态连接感知与认知。", "k": ["System 1：感知、快速、无意识", "System 2：逻辑、规划、语言", "KG 可作为感知到认知的桥梁"], "f": "", "pre": ["A-09-01-01"], "rel": ["A-09-01-03"], "p": "p.286-288", "m": "M11 / frontier §1", "c": "背景"},
        {"id": "A-09-01-03", "t": "多模态的价值", "ty": "原则", "d": "多模态可提供互补知识、辅助实体消歧、支持跨模态搜索、补全图谱并增强多模态任务。", "k": ["模态知识互补", "图像辅助同名实体消歧", "跨文本/图像/视频的语义检索", "KG 反过来增强视觉任务"], "f": "", "pre": ["A-09-01-01"], "rel": ["A-09-01-04"], "p": "p.288-291", "m": "M11 / frontier §1", "c": "核心"},
        {"id": "A-09-01-04", "t": "IMGpedia", "ty": "系统", "d": "IMGpedia 从维基百科图片提取视觉信息，构建视觉实体、图像描述符与相似性链接。", "k": ["视觉实体 + 图像描述符", "关联 Wikipedia/DBpedia 实体", "图像相似关系"], "f": "", "pre": ["A-09-01-03"], "rel": ["A-09-01-05"], "p": "p.291-292", "m": "M11 / frontier §1", "c": "背景"},
        {"id": "A-09-01-05", "t": "MMKG", "ty": "系统", "d": "MMKG 融合结构化属性、数值特征与实体图像，基于 FB15K/DBpedia/YAGO 构建多模态版本。", "k": ["实体-图像关系", "sameAs 跨图谱对齐", "用于多模态链接预测/实体匹配"], "f": "", "pre": ["A-09-01-04"], "rel": ["A-09-01-06"], "p": "p.292-293", "m": "M11 / frontier §1", "c": "背景"},
        {"id": "A-09-01-06", "t": "ImageGraph 与 Richpedia", "ty": "系统", "d": "ImageGraph 以图片为实体构建关系图；Richpedia 构建图像/文本实体及多模态语义关系。", "k": ["ImageGraph：图片实体 + 关系", "Richpedia：图像-文本实体 + 视觉关系", "长尾图像与位置关系是难点"], "f": "", "pre": ["A-09-01-05"], "rel": ["A-09-01-07"], "p": "p.293-295", "m": "M11 / frontier §1", "c": "背景"},
        {"id": "A-09-01-07", "t": "多模态图谱的应用", "ty": "方法", "d": "多模态可用于关系预测、知识图谱补全、视觉问答、场景图融合与推荐。", "k": ["多模态关系预测/补全", "视觉问答融合外部知识", "场景图与常识图谱融合", "多模态推荐"], "f": "", "pre": ["A-09-01-03"], "rel": ["A-09-02-08"], "p": "p.296-300", "m": "M11 / frontier §1", "c": "核心"}
      ]
    },
    {
      "sec": "9.2",
      "title": "知识图谱与语言预训练",
      "points": [
        {"id": "A-09-02-08", "t": "KG+语言预训练的动机", "ty": "原则", "d": "纯文本预训练捕获词共现，难处理复杂推理与低频实体；KG 可提供结构化事实与实体知识。", "k": ["文本预训练强于共现、弱于逻辑", "KG 提供实体/关系事实", "两者互补而非替代", "知识注入可提升低资源/低频实体"], "f": "", "pre": ["A-09-01-07"], "rel": ["A-09-02-09"], "p": "p.301", "m": "M11 / frontier §2", "c": "核心"},
        {"id": "A-09-02-09", "t": "语言预训练模型演进", "ty": "概念", "d": "Word2Vec/GloVe 学静态词向量；ELMo 按上下文动态调整；BERT 用 Transformer + 掩码语言模型。", "k": ["Word2Vec：上下文共现", "ELMo：上下文动态词向量", "BERT：掩码语言模型 + Transformer", "解决一词多义"], "f": "", "pre": ["A-09-02-08"], "rel": ["A-09-02-10"], "p": "p.301-303", "m": "M11 / frontier §2", "c": "背景"},
        {"id": "A-09-02-10", "t": "ERNIE 与 KnowBERT", "ty": "模型", "d": "ERNIE 用知识编码器融合实体嵌入，并设计实体掩码/对齐预训练目标；KnowBERT 端到端联合实体链接。", "k": ["实体向量注入语言模型", "T-Encoder + K-Encoder", "实体掩码预测", "实体链接联合训练"], "f": "", "pre": ["A-09-02-09"], "rel": ["A-09-02-11"], "p": "p.303-305", "m": "M11 / frontier §2", "c": "核心"},
        {"id": "A-09-02-11", "t": "WKLM 与 KEPLER", "ty": "模型", "d": "WKLM 随机替换实体做弱监督；KEPLER 用实体描述编码 + TransE 式目标联合训练。", "k": ["WKLM：实体替换检测", "KEPLER：文本描述编码 + 知识嵌入", "多任务学习注入知识"], "f": "", "pre": ["A-09-02-10"], "rel": ["A-09-02-12"], "p": "p.305-307", "m": "M11 / frontier §2", "c": "核心"},
        {"id": "A-09-02-12", "t": "K-Adapter", "ty": "模型", "d": "K-Adapter 冻结语言模型，用外部适配器注入不同类型知识，避免灾难性遗忘并产生解耦表示。", "k": ["适配器插件式注入", "每种知识一个 Adapter", "冻结主模型参数", "支持持续学习"], "f": "", "pre": ["A-09-02-11"], "rel": ["A-09-02-13"], "p": "p.307-308", "m": "M11 / frontier §2", "c": "核心"},
        {"id": "A-09-02-13", "t": "知识注入总结", "ty": "原则", "d": "知识注入有三种方式：实体向量输入、预训练任务、外部适配器；注入未必总是有效，噪声会带来损失。", "k": ["实体向量注入", "预训练任务注入", "外部适配器", "低资源/低频实体收益更明显", "需评估噪声与领域匹配"], "f": "", "pre": ["A-09-02-12"], "rel": ["A-09-03-14"], "p": "p.308", "m": "M11 / frontier §2", "c": "核心"}
      ]
    },
